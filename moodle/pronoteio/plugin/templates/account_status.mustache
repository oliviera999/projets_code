{{!
    @template local_pronoteio/account_status

    Status of the linked Pronote account.

    Example context (json):
    {
        "status": "Connected",
        "statusclass": "success",
        "lastsync": "Monday, 28 September 2026, 10:00",
        "unlinkurl": "https://example.com/local/pronoteio/account.php?action=unlink"
    }
}}
<div class="card mb-3 local-pronoteio-status">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div>
            {{#str}}status, local_pronoteio{{/str}} :
            <span class="badge bg-{{statusclass}}">{{status}}</span>
        </div>
        <div>{{#str}}lastsync, local_pronoteio{{/str}} : {{lastsync}}</div>
        <div class="ms-auto d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-action="local_pronoteio-test">
                {{#str}}testconnection, local_pronoteio{{/str}}
            </button>
            <a class="btn btn-outline-danger" href="{{unlinkurl}}">{{#str}}unlinkaccount, local_pronoteio{{/str}}</a>
        </div>
    </div>
</div>
